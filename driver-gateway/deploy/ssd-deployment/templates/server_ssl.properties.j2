# SSL Settings
ssl.keystore.location={{ kafka_ssl_dir }}/keystore.jks
ssl.keystore.password={{ kafka_keystore_password }}
ssl.key.password={{ kafka_key_password }}
ssl.truststore.location={{ kafka_ssl_dir }}/truststore.jks
ssl.truststore.password={{ kafka_truststore_password }}
ssl.client.auth=required
ssl.endpoint.identification.algorithm=

# SASL Authentication
security.protocol=SASL_SSL
sasl.enabled.mechanisms=SCRAM-SHA-256
sasl.mechanism.inter.broker.protocol=SCRAM-SHA-256
listeners=SASL_SSL://{{ privateIp }}:9092
advertised.listeners=SASL_SSL://{{ privateIp }}:9092
security.inter.broker.protocol=SASL_SSL

# SASL SCRAM Configuration
listener.name.sasl_ssl.scram-sha-256.sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required;

# Kafka Broker Config
broker.id={{ brokerId }}

log.dirs=/mnt/data-1,/mnt/data-2

zookeeper.connect={{ zookeeperServers }}

num.replica.fetchers=8

message.max.bytes=10485760

replica.fetch.max.bytes=10485760

num.network.threads=8